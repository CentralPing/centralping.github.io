---
import * as Plot from '@observablehq/plot';
import {JSDOM} from 'jsdom';
import benchmarks from '../../data/benchmarks.json';
import {FRAMEWORKS, COLORS} from './colors.js';

const PIPELINE_IDS = [
  '01-baseline-get',
  '02-param-get',
  '03-auth-get',
  '04-json-post',
  '05-full-pipeline',
  '07-production-stack',
];

const stages = benchmarks.scenarios
  .filter(s => PIPELINE_IDS.includes(s.id))
  .map((s, i) => ({...s, order: i}));

const rows = stages.flatMap(s =>
  s.results.map(r => ({
    stage: s.shortLabel,
    order: s.order,
    framework: r.framework,
    rps: r.rps,
  }))
);

const dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');
const plot = Plot.plot({
  document: dom.window.document,
  width: 928,
  height: 400,
  marginLeft: 60,
  marginBottom: 40,
  x: {
    label: null,
    domain: stages.map(s => s.shortLabel),
    padding: 0.3,
  },
  y: {
    label: 'Requests per second',
    grid: true,
    tickFormat: s => `${(s / 1000).toFixed(0)}k`,
  },
  color: {domain: FRAMEWORKS, range: COLORS, legend: true},
  marks: [
    Plot.line(rows, {
      x: 'stage',
      y: 'rps',
      stroke: 'framework',
      strokeWidth: 2.5,
    }),
    Plot.dot(rows, {
      x: 'stage',
      y: 'rps',
      fill: 'framework',
      r: 4,
    }),
  ],
});
const svg = plot.outerHTML;
---
<figure class="bench-chart">
  <div set:html={svg} />
  <figcaption>Throughput degradation as middleware complexity increases from Baseline to Production Stack. Flatter lines indicate lower middleware overhead.</figcaption>
</figure>
