{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".ergo-router-source/**/*.js"
  ],
  "exclude": [
    ".ergo-router-source/**/*.spec.js",
    ".ergo-router-source/**/*.spec.*.js"
  ]
}
