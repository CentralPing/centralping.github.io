{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".ergo-source/http/**/*.js",
    ".ergo-source/lib/**/*.js",
    ".ergo-source/utils/**/*.js"
  ],
  "exclude": [
    ".ergo-source/**/*.spec.js",
    ".ergo-source/**/*.spec.*.js"
  ]
}
